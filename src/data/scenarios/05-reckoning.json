{
  "id": "reckoning",
  "title": "Reckoning",
  "channelName": "#team",
  "openingMessages": [
    {
      "id": "re-1",
      "from": "engineer",
      "text": "I need to be honest with the team. I'm exhausted. I've been carrying the weight of this codebase for months and it's not sustainable.",
      "delayMs": 0
    },
    {
      "id": "re-2",
      "from": "designer",
      "text": "Same. Every feature feels like we're building on sand. I don't know what's going to break next.",
      "delayMs": 2500
    },
    {
      "id": "re-3",
      "from": "pm",
      "text": "Retention numbers are down. Users love the idea but the product keeps failing them.",
      "delayMs": 2000
    },
    {
      "id": "re-4",
      "from": "engineer",
      "text": "We need to decide something real here. Do we keep sprinting, or do we actually fix the foundation?",
      "delayMs": 2000
    },
    {
      "id": "re-5",
      "from": "engineer",
      "text": "And I need to be clear: if we choose to keep sprinting, I'm not sure I'll still be here in three months.",
      "delayMs": 2200,
      "condition": {
        "metric": "maintainability",
        "operator": "lte",
        "threshold": 30
      }
    }
  ],
  "choices": [
    {
      "id": "re-keep-shipping",
      "label": "Keep shipping features",
      "subtext": "Users need progress, not internal refactors.",
      "tagline": "Kept moving. Stopped looking down.",
