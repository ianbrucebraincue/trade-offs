          "text": "Okay. Feature roadmap continues.",
          "delayMs": 1000
        },
        {
          "id": "re-ship-2",
          "from": "engineer",
          "text": "Noted.",
          "delayMs": 3000
        },
        {
          "id": "re-ship-3",
